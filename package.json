{
  "name": "china-salticid-field-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中国跳蛛观察志 — 记录我们在中国野外调查与日常观察中遇见的跳蛛。",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run media && astro build",
    "preview": "astro preview",
    "media": "node scripts/process-media.mjs",
    "test:privacy": "node scripts/test-privacy.mjs",
    "studio:migrate": "npm --prefix studio run migrate",
    "studio": "npm --prefix studio run dev",
    "studio:export": "npm --prefix studio run export"
  },
  "dependencies": {
    "astro": "^5.12.0",
    "sharp": "^0.34.0",
    "@astrojs/cloudflare": "^12.6.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22"
  }
}
