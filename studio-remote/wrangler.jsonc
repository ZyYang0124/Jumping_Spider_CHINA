{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salticid-notes-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f505cbeb87d1685c29a48f32e61c2550",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salticid-studio",
      "database_id": "200e1a7e-83e0-439e-addb-c1d86e825c6e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "salticid-studio-media"
    }
  ],
  "routes": [
    { "pattern": "studio.salticidnotes.cn", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
