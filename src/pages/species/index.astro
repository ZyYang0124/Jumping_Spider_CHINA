---
import Base from '../../layouts/Base.astro';
import { getSpeciesGroups, getUnidentifiedObservations, speciesSlug } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { sciNameHtml } from '../../lib/format';
import ObsCard from '../../components/ObsCard.astro';
import { RANK_ZH } from '../../lib/labels';

const groups = getSpeciesGroups();
const unidentified = getUnidentifiedObservations();
---

<Base title="物种" description="由观察记录聚合而成的物种页面——是相遇的积累，不是名录的条目。">
  <div class="container">
    <div class="page-title">
      <h1>物种</h1>
      <p class="lede">
        这里的每个条目都由「已发布观察 + 当前鉴定」实时聚合而来，本站没有手工维护的百科条目。
        缺某个物种是常态——网站的边界由我们实际观察过什么决定。
      </p>
    </div>

    <div class="species-list">
      {groups.map((g) => (
        <a class="species-card" href={withBase(`/species/${speciesSlug(g)}/`)}>
          <div class="cover">
            {g.observations.find((o) => o.cover) && (
              <img
                src={g.observations.find((o) => o.cover)!.cover!.thumb}
                alt={`${g.display} 代表照片`}
                loading="lazy"
              />
            )}
          </div>
          <div class="body">
            <div class="name">
              <span set:html={sciNameHtml(g.display, g.rank)} />
              {g.taxon_status === 'provisional' && <span class="status-tag">暂定</span>}
            </div>
            <div class="sub">
              {RANK_ZH[g.rank] ?? g.rank}级 · {g.observations.length} 条记录<br />
              {g.provinces.join('、')}
              {g.chinese_name ? <><br />{g.chinese_name}</> : null}
            </div>
          </div>
        </a>
      ))}
    </div>

    <section class="section" style="padding-bottom: 70px;">
      <div class="section-head">
        <h2>未鉴定</h2>
      </div>
      <p class="section-lede">未知是一等公民。这些记录暂时没有鉴定，但它们同样成立。</p>
      {unidentified.length > 0 ? (
        <div class="card-grid">
          {unidentified.map((o) => <ObsCard obs={o} />)}
        </div>
      ) : (
        <div class="empty-state">目前所有记录都已有鉴定。</div>
      )}
    </section>
  </div>
</Base>
