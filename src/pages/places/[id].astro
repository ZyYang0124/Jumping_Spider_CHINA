---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import ObsCard from '../../components/ObsCard.astro';
import PictureImage from '../../components/PictureImage.astro';
import { getPlacePage, getPlaceRedirect, getPublicPlaces } from '../../lib/queries';
import { placeMergedInto } from '../../lib/store';
import { withBase } from '../../lib/privacy';
import { formatLat, formatLng, sciNameHtml } from '../../lib/format';

export function getStaticPaths() {
  // 全部地点实体：保留地点生成详情页；被合并的地点生成跳转页（保持旧 URL 可用）
  const ids = new Set(getPublicPlaces().map((p) => p.id));
  for (const merged of placeMergedInto.keys()) ids.add(merged);
  return [...ids].map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const redirect = getPlaceRedirect(id!);
if (redirect) return Astro.redirect(redirect);
const data = getPlacePage(id!);
if (!data) return Astro.redirect(withBase('/places/'));
const { place, observations, species, posts } = data;
const photos = observations.flatMap((o) => o.media.slice(0, 2)).slice(0, 10);
---

<Base title={`${place.name} · 地点`} description={`${place.name}：本站共 ${observations.length} 条观察记录。`}>
  <div class="container-wide place-page">
    <header class="place-hero">
      <div class="kicker on-paper">地 点 · {place.country}</div>
      <h1>{place.name}</h1>
      <div class="place-region">
        {[place.admin1, place.admin2, place.locality, place.site_name].filter(Boolean).join(' · ')}
      </div>
      <div class="place-meta">
        {place.elevation_m != null && <span>海拔约 {place.elevation_m} m</span>}
        {place.latitude != null && place.longitude != null && (
          <span>{formatLat(place.latitude)} · {formatLng(place.longitude)}</span>
        )}
        <span>{observations.length} 次相遇</span>
        <span>{species.length} 个类群</span>
      </div>
      {place.description && <p class="place-desc">{place.description}</p>}
    </header>

    {photos.length > 0 && (
      <section class="place-photos">
        {photos.map((m) => (
          <a class="place-photo" href={m.detail_url}>
            <PictureImage media={m} sizes="(max-width: 700px) 46vw, 24vw" alt={m.caption ?? place.name} />
          </a>
        ))}
      </section>
    )}

    {species.length > 0 && (
      <section class="place-section">
        <h2>在此记录的物种</h2>
        <div class="place-species">
          {species.map((s) => (
            <a class="species-chip" href={s.slug ? withBase(`/species/${s.slug}/`) : undefined}>
              <span set:html={sciNameHtml(s.display, s.rank ?? 'species')} />
              <span class="n">{s.count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="place-section">
      <h2>观察记录</h2>
      <div class="card-grid">
        {observations.map((o) => <ObsCard obs={o} />)}
      </div>
    </section>

    {posts.length > 0 && (
      <section class="place-section">
        <h2>相关札记</h2>
        <ul class="place-posts">
          {posts.map((p) => (
            <li><a href={p.url}>{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="place-legend">
      本站观察地点坐标均精确公开。返回 <a href={withBase('/places/')}>全部地点</a> 或到 <a href={withBase('/observations/')}>观察</a> 页按永久编号检索。
    </p>
  </div>
</Base>

<style>
  .place-page { padding-bottom: 70px; }
  .place-hero { padding: 44px 0 26px; border-bottom: 1px solid var(--line); margin-bottom: 30px; }
  .place-hero h1 {
    font-family: var(--serif); font-weight: 700; letter-spacing: 0.06em;
    font-size: clamp(30px, 4.5vw, 44px); margin: 14px 0 10px;
  }
  .place-region { color: var(--muted); font-size: 15px; letter-spacing: 0.04em; }
  .place-meta {
    display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px;
    font-size: 13px; color: var(--faint); letter-spacing: 0.04em;
  }
  .place-desc { max-width: 640px; color: var(--ink); line-height: 1.9; margin: 18px 0 0; }

  .place-photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 44px; }
  .place-photo { display: block; }
  .place-photo :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1; display: block; }

  .place-section { margin: 0 0 48px; }
  .place-section h2 {
    font-family: var(--serif); font-size: 20px; font-weight: 700; letter-spacing: 0.12em;
    margin: 0 0 18px; padding-bottom: 10px; border-bottom: 1px solid var(--line);
  }
  .place-species { display: flex; flex-wrap: wrap; gap: 10px; }
  .species-chip {
    display: inline-flex; align-items: baseline; gap: 8px;
    border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px;
    font-size: 14px; text-decoration: none; color: var(--ink); background: #fff;
  }
  .species-chip:hover { border-color: var(--terra); }
  .species-chip .n { font-size: 12px; color: var(--faint); }
  .place-posts { list-style: none; margin: 0; padding: 0; }
  .place-posts li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .place-posts a { color: var(--ink); text-decoration: none; }
  .place-posts a:hover { color: var(--terra); }
  .place-legend { font-size: 12.5px; color: var(--faint); line-height: 1.9; }
  .place-legend a { color: var(--muted); }

  @media (max-width: 700px) {
    .place-photos { grid-template-columns: repeat(2, 1fr); }
  }
</style>
