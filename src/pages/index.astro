---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PictureImage from '../components/PictureImage.astro';
import ObsCard from '../components/ObsCard.astro';
import FieldPostcard from '../components/FieldPostcard.astro';
import { allPublicObservations, getPublicTrips, getLocalityCards, getSpeciesGroups, speciesSlug } from '../lib/queries';
import { withBase } from '../lib/privacy';
import { siteConfig } from '../lib/store';
import { sciNameHtml, formatDate, shortRegion } from '../lib/format';

// 首页大图轮播：最新发布的 5 张封面，自动轮换（§12 编辑条同源数据）
const heroes = allPublicObservations.filter((o) => o.cover).slice(0, 5);
const hero = heroes[0]?.cover ?? null;
const heroPreload = hero
  ? {
      href: hero.medium,
      imagesrcset: [hero.srcset.avif, hero.srcset.webp, hero.srcset.jpg].map((ss) => ss).join(', '),
      imagesizes: '100vw',
    }
  : undefined;
const recent = allPublicObservations.slice(0, 5);
const [leadTrip, sideTrip] = getPublicTrips().slice(0, 2);
// 明信片（§100/§102 首页 1 张）：头条调查的正面 + 背面取该程最新一条真实札记
const leadNoteObs = leadTrip
  ? allPublicObservations
      .filter((o) => o.trip?.slug === leadTrip.slug && o.field_note)
      .sort((a, b) => b.observed_at.localeCompare(a.observed_at))[0]
  : undefined;
const leadPostcard = leadTrip && leadTrip.cover
  ? {
      photo: leadTrip.cover,
      place: leadTrip.title,
      region: leadTrip.region,
      date: leadTrip.start_date.slice(0, 4) + ' · ' + leadTrip.start_date.slice(5, 7),
      dateFull:
        `${Number(leadTrip.start_date.slice(0, 4))} 年 ${Number(leadTrip.start_date.slice(5, 7))} 月 ${Number(leadTrip.start_date.slice(8, 10))} 日 — ${Number(leadTrip.end_date.slice(5, 7))} 月 ${Number(leadTrip.end_date.slice(8, 10))} 日`,
      id: leadNoteObs?.public_id ?? null,
      note: leadNoteObs?.field_note ?? null,
      lat: leadNoteObs?.location.latitude ?? null,
      lng: leadNoteObs?.location.longitude ?? null,
      href: `/trips/${leadTrip.slug}/`,
    }
  : null;
const species = getSpeciesGroups().slice(0, 4);
const places = getLocalityCards().slice(0, 3);
---

<Base preload={heroPreload ?? undefined}>
  <section class="hero" data-hero-carousel>
    {heroes.map((h, i) => (
      <img
        class:list={['hero-photo', { 'is-active': i === 0 }]}
        src={h.cover.large}
        alt={`封面照片 · ${h.public_id}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        data-hero-slide={i}
        data-credit={h.cover.photographer ?? ''}
      />
    ))}
    <div class="veil"></div>
    <div class="hero-dots">
      {heroes.map((_, i) => (
        <button type="button" class:list={['hero-dot', { on: i === 0 }]} data-hero-dot={i} aria-label={`切换到第 ${i + 1} 张封面`} />
      ))}
    </div>
    <div class="inner">
      <div class="kicker">始于 2023</div>
      <h1>{siteConfig.site_name}</h1>
      <p>{siteConfig.subtitle}</p>
      <div class="actions">
        <a class="btn solid" href={withBase('/observations/')}>浏览观察</a>
        <a class="btn" href={withBase('/trips/')}>阅读野外调查</a>
      </div>
    </div>
    {hero && <span class="hero-credit">© <span data-hero-credit>{hero.photographer}</span></span>}
  </section>


  <script data-astro-rerun>
    (function () {
      function init() {
        var hero = document.querySelector('[data-hero-carousel]');
        if (!hero || hero.dataset.carouselBound) return;
        hero.dataset.carouselBound = '1';
        var slides = Array.prototype.slice.call(hero.querySelectorAll('[data-hero-slide]'));
        var dots = Array.prototype.slice.call(hero.querySelectorAll('[data-hero-dot]'));
        var credit = hero.querySelector('[data-hero-credit]');
        if (slides.length < 2) { if (dots.length) dots.forEach(function (d) { d.remove(); }); return; }
        var i = 0, timer = null;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function show(n) {
          i = (n + slides.length) % slides.length;
          slides.forEach(function (s, k) { s.classList.toggle('is-active', k === i); });
          dots.forEach(function (d, k) { d.classList.toggle('on', k === i); });
          if (credit) credit.textContent = slides[i].getAttribute('data-credit') || '';
        }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }
        function play() { if (!reduce && !timer) timer = setInterval(function () { show(i + 1); }, 6000); }
        dots.forEach(function (d, k) {
          d.addEventListener('click', function () { show(k); stop(); play(); });
        });
        hero.addEventListener('mouseenter', stop);
        hero.addEventListener('mouseleave', play);
        show(0);
        play();
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>

  <div class="container-wide">
    <!-- 最近的相遇：紧凑 editorial strip（§12/§13） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>最近的相遇</h2>
        <a class="more" href={withBase('/observations/')}>全部观察 →</a>
      </div>
      <div class="strip-grid">
        {recent.map((o) => <ObsCard obs={o} />)}
      </div>
    </section>

    <!-- 来自野外：非对称 field story（§14/§15） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>来自野外</h2>
        <a class="more" href={withBase('/trips/')}>全部调查 →</a>
      </div>
      {leadTrip && (
      <div class="story-grid">
        {leadPostcard ? (
          <FieldPostcard
            photo={leadPostcard.photo}
            place={leadPostcard.place}
            region={leadPostcard.region}
            date={leadPostcard.date}
            dateFull={leadPostcard.dateFull}
            id={leadPostcard.id}
            note={leadPostcard.note}
            lat={leadPostcard.lat}
            lng={leadPostcard.lng}
            href={withBase(leadPostcard.href)}
          />
        ) : (
        <a class="story story-lead" href={withBase(`/trips/${leadTrip.slug}/`)}>
          <div class="frame">
            {leadTrip.cover && (
              <PictureImage
                media={leadTrip.cover}
                sizes="(max-width: 900px) 92vw, 60vw"
                alt={`${leadTrip.title} 封面`}
                transitionName={`trip-${leadTrip.slug}`}
              />
            )}
          </div>
          <div class="dates">{leadTrip.region} · {leadTrip.start_date} – {leadTrip.end_date} · {leadTrip.observations.length} 次相遇</div>
          <h2>{leadTrip.title}</h2>
          {leadTrip.subtitle && <div class="story-sub">{leadTrip.subtitle}</div>}
          <p>{leadTrip.summary}</p>
        </a>
        )}
        {sideTrip && (
          <a class="story story-side" href={withBase(`/trips/${sideTrip.slug}/`)}>
            <div class="frame">
              {sideTrip.cover && (
                <PictureImage
                  media={sideTrip.cover}
                  sizes="(max-width: 900px) 92vw, 34vw"
                  alt={`${sideTrip.title} 封面`}
                  transitionName={`trip-${sideTrip.slug}`}
                />
              )}
            </div>
            <div class="dates">{sideTrip.region} · {sideTrip.start_date} – {sideTrip.end_date} · {sideTrip.observations.length} 次相遇</div>
            <h2>{sideTrip.title}</h2>
            {sideTrip.subtitle && <div class="story-sub">{sideTrip.subtitle}</div>}
          </a>
        )}
      </div>
      )}
    </section>

    <!-- 相遇的物种：自然史索引（§16/§17） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>相遇的物种</h2>
        <a class="more" href={withBase('/species/')}>全部物种 →</a>
      </div>
      <p class="section-lede">物种页由观察记录聚合而成——它们是相遇的积累，而不是名录的条目。</p>
      <div class="species-mini">
        {species.map((g) => (
          <a class="species-card" href={withBase(`/species/${speciesSlug(g)}/`)}>
            <div class="frame">
              {g.observations.find((o) => o.cover) && (
                <PictureImage
                  media={g.observations.find((o) => o.cover)!.cover!}
                  sizes="(max-width: 900px) 46vw, 24vw"
                  alt={`${g.display} 的代表照片`}
                />
              )}
            </div>
            <div class="name" set:html={sciNameHtml(g.display, g.rank)} />
            <div class="sub">{g.observations.length} 次相遇 · {g.regions.join('、')}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- 地点：明确的位置（§18/§19/§76） -->
    <section class="section reveal" style="padding-bottom: var(--s-8);">
      <div class="section-head">
        <h2>地点</h2>
        <a class="more" href={withBase('/places/')}>全部地点 →</a>
      </div>
      <p class="section-lede">每一次相遇都有明确的位置。地点不是附属信息，而是自然史记录的一部分。</p>
      <div class="place-cards">
        {places.map((p) => (
          <a class="place-card" href={withBase('/places/')}>
            <div class="frame">{p.cover && <img src={p.cover.medium} alt={p.name} loading="lazy" />}</div>
            <div class="name">{p.name}</div>
            <div class="meta">{p.country_name === '中国' ? p.admin1 : p.country_name + ' · ' + p.admin1} · {p.count} 次相遇{p.elevation != null ? ` · 海拔约 ${p.elevation} m` : ''}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>


