---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PictureImage from '../components/PictureImage.astro';
import ObsCard from '../components/ObsCard.astro';
import { allPublicObservations, getPublicTrips, getLocalityCards, getSpeciesGroups, speciesSlug } from '../lib/queries';
import { withBase } from '../lib/privacy';
import { siteConfig } from '../lib/store';
import { sciNameHtml, formatDate, shortRegion } from '../lib/format';

const hero = allPublicObservations.find((o) => o.cover?.id === 'm-3047463f')?.cover ?? allPublicObservations[0]?.cover ?? null;
const heroPreload = hero
  ? {
      href: hero.medium,
      imagesrcset: [hero.srcset.avif, hero.srcset.webp, hero.srcset.jpg].map((ss) => ss).join(', '),
      imagesizes: '100vw',
    }
  : undefined;
const recent = allPublicObservations.slice(0, 5);
const [leadTrip, sideTrip] = getPublicTrips().slice(0, 2);
const species = getSpeciesGroups().slice(0, 4);
const places = getLocalityCards().slice(0, 3);
---

<Base preload={heroPreload ?? undefined}>
  <section class="hero">
    {hero && <img class="hero-photo" src={hero.large} alt="封面照片：求偶中的雄性翠蛛" fetchpriority="high" />}
    <div class="veil"></div>
    <div class="inner">
      <div class="kicker">始于 2023</div>
      <h1>{siteConfig.site_name}</h1>
      <p>{siteConfig.subtitle}</p>
      <div class="actions">
        <a class="btn solid" href={withBase('/observations/')}>浏览观察</a>
        <a class="btn" href={withBase('/trips/')}>阅读野外调查</a>
      </div>
    </div>
    {hero && <span class="hero-credit">© {hero.photographer}</span>}
  </section>

  <div class="container-wide">
    <!-- 最近的相遇：紧凑 editorial strip（§12/§13） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>最近的相遇</h2>
        <a class="more" href={withBase('/observations/')}>全部观察 →</a>
      </div>
      <div class="strip-grid">
        {recent.map((o) => <ObsCard obs={o} />)}
      </div>
    </section>

    <!-- 来自野外：非对称 field story（§14/§15） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>来自野外</h2>
        <a class="more" href={withBase('/trips/')}>全部调查 →</a>
      </div>
      {leadTrip && (
      <div class="story-grid">
        <a class="story story-lead" href={withBase(`/trips/${leadTrip.slug}/`)}>
          <div class="frame">
            {leadTrip.cover && (
              <PictureImage
                media={leadTrip.cover}
                sizes="(max-width: 900px) 92vw, 60vw"
                alt={`${leadTrip.title} 封面`}
                transitionName={`trip-${leadTrip.slug}`}
              />
            )}
          </div>
          <div class="dates">{leadTrip.region} · {leadTrip.start_date} – {leadTrip.end_date} · {leadTrip.observations.length} 次相遇</div>
          <h2>{leadTrip.title}</h2>
          {leadTrip.subtitle && <div class="story-sub">{leadTrip.subtitle}</div>}
          <p>{leadTrip.summary}</p>
        </a>
        {sideTrip && (
          <a class="story story-side" href={withBase(`/trips/${sideTrip.slug}/`)}>
            <div class="frame">
              {sideTrip.cover && (
                <PictureImage
                  media={sideTrip.cover}
                  sizes="(max-width: 900px) 92vw, 34vw"
                  alt={`${sideTrip.title} 封面`}
                  transitionName={`trip-${sideTrip.slug}`}
                />
              )}
            </div>
            <div class="dates">{sideTrip.region} · {sideTrip.start_date} – {sideTrip.end_date} · {sideTrip.observations.length} 次相遇</div>
            <h2>{sideTrip.title}</h2>
            {sideTrip.subtitle && <div class="story-sub">{sideTrip.subtitle}</div>}
          </a>
        )}
      </div>
      )}
    </section>

    <!-- 相遇的物种：自然史索引（§16/§17） -->
    <section class="section reveal">
      <div class="section-head">
        <h2>相遇的物种</h2>
        <a class="more" href={withBase('/species/')}>全部物种 →</a>
      </div>
      <p class="section-lede">物种页由观察记录聚合而成——它们是相遇的积累，而不是名录的条目。</p>
      <div class="species-mini">
        {species.map((g) => (
          <a class="species-card" href={withBase(`/species/${speciesSlug(g)}/`)}>
            <div class="frame">
              {g.observations.find((o) => o.cover) && (
                <PictureImage
                  media={g.observations.find((o) => o.cover)!.cover!}
                  sizes="(max-width: 900px) 46vw, 24vw"
                  alt={`${g.display} 的代表照片`}
                />
              )}
            </div>
            <div class="name" set:html={sciNameHtml(g.display, g.rank)} />
            <div class="sub">{g.observations.length} 次相遇 · {g.regions.join('、')}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- 地点：明确的位置（§18/§19/§76） -->
    <section class="section reveal" style="padding-bottom: var(--s-8);">
      <div class="section-head">
        <h2>地点</h2>
        <a class="more" href={withBase('/places/')}>全部地点 →</a>
      </div>
      <p class="section-lede">每一次相遇都有明确的位置。地点不是附属信息，而是自然史记录的一部分。</p>
      <div class="place-cards">
        {places.map((p) => (
          <a class="place-card" href={withBase('/places/')}>
            <div class="frame">{p.cover && <img src={p.cover.medium} alt={p.name} loading="lazy" />}</div>
            <div class="name">{p.name}</div>
            <div class="meta">{p.country_name === '中国' ? p.admin1 : p.country_name + ' · ' + p.admin1} · {p.count} 次相遇{p.elevation != null ? ` · 海拔约 ${p.elevation} m` : ''}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
