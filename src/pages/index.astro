---
export const prerender = true;
import Base from '../layouts/Base.astro';
import ObsCard from '../components/ObsCard.astro';
import { allPublicObservations, getPublicTrips, getLocalityCards, getSpeciesGroups, speciesSlug } from '../lib/queries';
import { withBase } from '../lib/privacy';
import { siteConfig } from '../lib/store';
import { sciNameHtml, formatDate, shortRegion } from '../lib/format';
import { LOCATION_VISIBILITY_ZH } from '../lib/labels';

const hero = allPublicObservations.find((o) => o.cover?.id === 'm-3047463f')?.cover ?? allPublicObservations[0]?.cover ?? null;
const [lead, ...rest] = allPublicObservations;
const featuredSide = rest.slice(0, 2);
const grid = rest.slice(2, 7);
const trips = getPublicTrips().slice(0, 2);
const species = getSpeciesGroups().slice(0, 4);
const places = getLocalityCards().slice(0, 3);
const years = allPublicObservations.length > 0
  ? `${allPublicObservations.at(-1)!.observed_at.slice(0, 4)}—${allPublicObservations[0].observed_at.slice(0, 4)}`
  : '';
---

<Base>
  <section class="hero">
    {hero && <img class="hero-photo" src={hero.large} alt="封面照片：求偶中的雄性翠蛛" fetchpriority="high" />}
    <div class="veil"></div>
    <div class="inner">
      <div class="kicker">Field Notes · {years}</div>
      <h1>{siteConfig.site_name}</h1>
      <p>{siteConfig.subtitle}</p>
      <div class="actions">
        <a class="btn solid" href={withBase('/observations/')}>浏览观察记录</a>
        <a class="btn" href={withBase('/trips/')}>阅读野外调查</a>
      </div>
    </div>
    {hero && <span class="hero-credit">© {hero.photographer}</span>}
  </section>

  <div class="container-wide">
    <section class="section">
      <div class="section-head">
        <h2>最近的野外笔记</h2>
        <a class="more" href={withBase('/observations/')}>全部记录 →</a>
      </div>
      <p class="section-lede">每一条记录都始于一次相遇：在哪里、什么时候、以怎样的方式。</p>

      <div class="featured-grid">
        {lead && (
          <a class="ed-card ed-lead" href={lead.url}>
            <div class="frame">
              {lead.cover && <img src={lead.cover.large} alt={lead.cover.caption ?? lead.public_id} fetchpriority="high" />}
            </div>
            <div class="meta">
              <div class="name">
                {lead.identification ? (
                  <span set:html={sciNameHtml(lead.identification.display, lead.identification.taxon_rank)} />
                ) : (
                  <span>未鉴定的跳蛛</span>
                )}
              </div>
              <div class="sub">
                {formatDate(lead.observed_at, lead.observed_at_precision)} · {shortRegion(lead.location)}
              </div>
              <p class="excerpt">{lead.field_note}</p>
            </div>
          </a>
        )}
        {featuredSide.map((o) => (
          <a class="ed-card ed-side" href={o.url}>
            <div class="frame">
              {o.cover && <img src={o.cover.medium} alt={o.cover.caption ?? o.public_id} loading="lazy" />}
            </div>
            <div class="meta">
              <div class="name">
                {o.identification ? (
                  <span set:html={sciNameHtml(o.identification.display, o.identification.taxon_rank)} />
                ) : (
                  <span>未鉴定的跳蛛</span>
                )}
              </div>
              <div class="sub">
                {formatDate(o.observed_at, o.observed_at_precision)} · {shortRegion(o.location)}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="card-grid" style="margin-top: 40px;">
        {grid.map((o) => <ObsCard obs={o} />)}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>来自野外</h2>
        <a class="more" href={withBase('/trips/')}>全部调查 →</a>
      </div>
      <div class="trip-list">
        {trips.map((t) => (
          <a class="trip-card" href={withBase(`/trips/${t.slug}/`)}>
            <div class="cover">{t.cover && <img src={t.cover.large} alt={`${t.title} 封面`} loading="lazy" />}</div>
            <h2>{t.title}</h2>
            {t.subtitle && <div class="sub-title">{t.subtitle}</div>}
            <div class="dates">{t.region} · {t.start_date} – {t.end_date} · {t.observations.length} 条记录</div>
            <p>{t.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>相遇的物种</h2>
        <a class="more" href={withBase('/species/')}>全部物种 →</a>
      </div>
      <p class="section-lede">物种页由观察记录聚合而成——它们是相遇的积累，而不是名录的条目。</p>
      <div class="species-list" style="padding-top: 0;">
        {species.map((g) => (
          <a class="species-card" href={withBase(`/species/${speciesSlug(g)}/`)}>
            <div class="frame">
              {g.observations.find((o) => o.cover) && (
                <img
                  src={g.observations.find((o) => o.cover)!.cover!.medium}
                  alt={`${g.display} 的代表照片`}
                  loading="lazy"
                />
              )}
            </div>
            <div class="name" set:html={sciNameHtml(g.display, g.rank)} />
            <div class="sub">{g.observations.length} 条记录 · {g.regions.join('、')}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" style="padding-bottom: 70px;">
      <div class="section-head">
        <h2>地点</h2>
        <a class="more" href={withBase('/places/')}>全部地点 →</a>
      </div>
      <p class="section-lede">敏感到位的记录只公开到地名，甚至完全保密——这是本站从第一天就坚持的底线。</p>
      <div class="place-cards">
        {places.map((p) => (
          <a class="place-card" href={withBase('/places/')}>
            <div class="frame">{p.cover && <img src={p.cover.medium} alt={p.name} loading="lazy" />}</div>
            <div class="name">{p.name}</div>
            <div class="meta">{p.country_name === '中国' ? p.admin1 : p.country_name + ' · ' + p.admin1} · {p.count} 次相遇{p.elevation != null ? ` · 海拔约 ${p.elevation} m` : ''} · {LOCATION_VISIBILITY_ZH[p.visibilityLabel as keyof typeof LOCATION_VISIBILITY_ZH]}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
