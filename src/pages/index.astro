---
import Base from '../layouts/Base.astro';
import ObsCard from '../components/ObsCard.astro';
import { allPublicObservations, getPublicTrips, getProvinceGroups, getSpeciesGroups, speciesSlug } from '../lib/queries';
import { withBase } from '../lib/privacy';
import { siteConfig } from '../lib/store';
import { sciNameHtml } from '../lib/format';

const hero = allPublicObservations.find((o) => o.cover?.id === 'm-3047463f')?.cover ?? allPublicObservations[0]?.cover ?? null;
const recent = allPublicObservations.slice(0, 8);
const trips = getPublicTrips().slice(0, 2);
const provinces = getProvinceGroups().slice(0, 6);
const species = getSpeciesGroups().slice(0, 4);
---

<Base>
  <section class="hero">
    {hero && <img class="hero-photo" src={hero.large} alt="封面照片：求偶中的雄性翠蛛" fetchpriority="high" />}
    <div class="veil"></div>
    <div class="inner">
      <div class="sub-en">{siteConfig.site_name_en}</div>
      <h1>{siteConfig.site_name}</h1>
      <p>{siteConfig.subtitle}</p>
      <div class="actions">
        <a class="btn solid" href={withBase('/observations/')}>浏览观察记录</a>
        <a class="btn" href={withBase('/trips/')}>阅读野外调查</a>
      </div>
    </div>
    {hero && <span class="hero-credit">© {hero.photographer}</span>}
  </section>

  <div class="container">
    <section class="section">
      <div class="section-head">
        <h2>最近的野外笔记</h2>
        <a class="more" href={withBase('/observations/')}>全部记录 →</a>
      </div>
      <p class="section-lede">每一条记录都始于一次相遇：在哪里、什么时候、以怎样的方式。</p>
      <div class="card-grid">
        {recent.map((o) => <ObsCard obs={o} />)}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>来自野外</h2>
        <a class="more" href={withBase('/trips/')}>全部调查 →</a>
      </div>
      <div class="trip-list">
        {trips.map((t) => (
          <a class="trip-card" href={withBase(`/trips/${t.slug}/`)}>
            <div class="cover">{t.cover && <img src={t.cover.medium} alt={`${t.title} 封面`} loading="lazy" />}</div>
            <div class="body">
              <h2>{t.title}</h2>
              <div class="dates">{t.province} · {t.start_date} – {t.end_date} · {t.observations.length} 条记录</div>
              <p>{t.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>物种种语</h2>
        <a class="more" href={withBase('/species/')}>全部物种 →</a>
      </div>
      <p class="section-lede">物种页由观察记录聚合而成——它们是相遇的积累，而不是名录的条目。</p>
      <div class="card-grid">
        {species.map((g) => (
          <a class="obs-card" href={withBase(`/species/${speciesSlug(g)}/`)}>
            <div class="frame">
              {g.observations.find((o) => o.cover) && (
                <img
                  src={g.observations.find((o) => o.cover)!.cover!.thumb}
                  alt={`${g.display} 的代表照片`}
                  loading="lazy"
                />
              )}
            </div>
            <div class="meta">
              <div class="name" set:html={sciNameHtml(g.display, g.rank)} />
              <div class="sub">{g.observations.length} 条记录 · {g.provinces.join('、')}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" style="padding-bottom: 70px;">
      <div class="section-head">
        <h2>按地点探索</h2>
        <a class="more" href={withBase('/places/')}>全部地点 →</a>
      </div>
      <p class="section-lede">敏感到位的记录只公开到地名，甚至完全保密——这是本站从第一天就坚持的底线。</p>
      <div class="place-rows" style="border-top: 1px solid var(--line);">
        {provinces.map((p) => (
          <div class="place-row">
            <span class="loc-name">{p.province}</span>
            <span class="loc-meta">{p.count} 条记录 · {p.localities.length} 个地点</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
