---
export const prerender = true;
import Base from '../layouts/Base.astro';
import EightEyes from '../components/EightEyes.astro';
import { withBase } from '../lib/privacy';
---

<Base title="页面不存在">
  <div class="container">
    <div class="notfound">
      <div class="mark"><EightEyes size={56} /></div>
      <h1>404</h1>
      <p>这里没有记录。</p>
      <p><a href={withBase('/observations/')} style="text-decoration: underline;">返回观察志 →</a></p>
    </div>
  </div>
</Base>
