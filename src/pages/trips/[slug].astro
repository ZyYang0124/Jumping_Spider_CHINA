---
// 调查已并入野外笔记：旧 URL 永久跳转到对应笔记（规则 29）
export const prerender = true;
import { getPublishedPosts } from '../../lib/queries';

export function getStaticPaths() {
  return getPublishedPosts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const known = getPublishedPosts().some((p) => p.slug === slug);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>野外笔记</title>
<meta http-equiv="refresh" content={`0; url=/posts/${slug}/`} />
<link rel="canonical" href={`/posts/${slug}/`} /></head>
<body>该调查已并入 <a href={`/posts/${slug}/`}>野外笔记</a>。</body></html>
