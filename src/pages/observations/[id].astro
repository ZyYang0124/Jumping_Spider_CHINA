---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import PictureImage from '../../components/PictureImage.astro';
import SciName from '../../components/SciName.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import ObsCard from '../../components/ObsCard.astro';
import { getObservation, allPublicObservations } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { SEX_ZH, LIFE_STAGE_ZH } from '../../lib/labels';
import { formatDate, coordLabel, locationLine, sciNameHtml , formatLat, formatLng} from '../../lib/format';

export function getStaticPaths() {
  return allPublicObservations.map((o) => ({ params: { id: o.public_id } }));
}

const { id } = Astro.params;
const obs = getObservation(id!);
if (!obs) return Astro.redirect(withBase('/observations/'));
const loc = obs.location;

const traits: [string, string | null][] = [
  ['性别', SEX_ZH[obs.sex as keyof typeof SEX_ZH] ?? null],
  ['龄期', LIFE_STAGE_ZH[obs.life_stage as keyof typeof LIFE_STAGE_ZH] ?? null],
  ['生境', obs.habitat],
  ['小生境', obs.microhabitat],
  ['行为', obs.behavior],
];

const related = allPublicObservations
  .filter(
    (o) =>
      o.public_id !== obs.public_id &&
      (o.identification?.display === obs.identification?.display ||
        o.trip?.slug === obs.trip?.slug ||
        o.location.admin1 === obs.location.admin1 && o.location.country_code === obs.location.country_code),
  )
  .slice(0, 3);
---

<Base title={`${obs.identification?.display ?? '未鉴定的跳蛛'} · ${obs.public_id}`} description={obs.field_note.slice(0, 80)}>
  <figure class="obs-hero">
    <div class="frame" id="hero-open" role="button" tabindex="0" aria-label="查看完整原始照片">
      {obs.cover && (
        <PictureImage
          media={obs.cover}
          sizes="(max-width: 1320px) 100vw, 1320px"
          alt={obs.cover.caption ?? obs.public_id}
          eager={true}
          fetchpriority="high"
          transitionName={`obs-${obs.public_id}`}
        />
      )}
    </div>
    {obs.cover && <figcaption class="hint">点击查看完整原始照片 · {coordLabel(loc) ?? ''}</figcaption>}
  </figure>

  <div class="lightbox" id="hero-lightbox" role="dialog" aria-modal="true" aria-label="原始照片">
    <button class="close" type="button" aria-label="关闭">×</button>
    {obs.cover && <img src={obs.cover.large} alt={obs.cover.caption ?? obs.public_id} />}
    <div class="cap">
      <span class="text">{obs.cover?.caption ?? ''}</span>
      <span class="who">© {obs.cover?.photographer ?? ''}</span>
    </div>
  </div>

  <div class="container">
    <header class="obs-title">
      <div class="pub-id">{obs.public_id}</div>
      <h1>
        {obs.identification ? (
          <span set:html={sciNameHtml(obs.identification.display, obs.identification.taxon_rank)} />
        ) : (
          <span>未鉴定的跳蛛</span>
        )}
      </h1>
      <div class="byline">
        {locationLine(loc)} · {formatDate(obs.observed_at, obs.observed_at_precision)}
        <br />
        观察者 {obs.observer_name}
      </div>
    </header>

    <div class="obs-body">
      <article>
        <section class="field-note">
          <div class="label">野 外 笔 记</div>
          {obs.field_note.split('\n').map((p) => <p>{p}</p>)}
        </section>

        {obs.media.length > 0 && (
          <section style="margin-top: 26px;">
            <MediaGallery media={obs.media} curatedLimit={6} />
          </section>
        )}

        <section class="side-block" style="margin-top: 30px; border-top: none; padding-top: 0;">
          {obs.identification ? (
            <>
              <h3 class="side-kicker">鉴 定</h3>
              <div class="side-primary">
                <SciName display={obs.identification.display} rank={obs.identification.taxon_rank} />
                <EvidenceBadge evidence={obs.identification.evidence} />
              </div>
              <div class="side-footnote">
                {obs.identification.identified_by} · {obs.identification.identified_at}
                {obs.identification.remarks && <br />}
                {obs.identification.remarks}
              </div>
            </>
          ) : (
            <>
              <h3 class="side-kicker">鉴 定</h3>
              <p class="side-secondary" style="margin: 0;">
                暂无鉴定。未知与存疑的记录同样是有效观察。
              </p>
            </>
          )}
          {obs.identification_history.length > 1 && (
            <div class="id-history">
              <details>
                <summary>鉴定历史（{obs.identification_history.length} 条，鉴定可变而记录不变）</summary>
                <ul>
                  {obs.identification_history.map((h) => (
                    <li class={obs.identification && h.identified_at !== obs.identification.identified_at ? 'old' : ''}>
                      {h.identified_at} · <span set:html={sciNameHtml(h.display, h.taxon_rank)} />
                      （{h.evidence}）— {h.identified_by}
                    </li>
                  ))}
                </ul>
              </details>
            </div>
          )}
        </section>

        {obs.specimen && (
          <section class="side-block">
            <h3 class="side-kicker">标 本</h3>
            <div class="side-secondary">
              {obs.specimen.catalog_number} · {obs.specimen.repository}
              {obs.specimen.preservation ? ` · ${obs.specimen.preservation}` : ''}
              {obs.specimen.notes && <br />}
              {obs.specimen.notes}
            </div>
          </section>
        )}
      </article>

      <aside>
        <section class="side-block" style="border-top: none; padding-top: 0;">
          <h3 class="side-kicker">地 点</h3>
          <div class="side-primary">{loc.locality ?? loc.site_name ?? loc.admin2 ?? loc.admin1}</div>
          <div class="side-secondary">{[loc.country_name, loc.admin1].filter(Boolean).join(' · ')}</div>
          <div class="side-footnote">
            {loc.elevation_m != null && <>海拔约 {loc.elevation_m} m<br /></>}
            {loc.latitude != null && loc.longitude != null ? (
              <>{formatLat(loc.latitude)} · {formatLng(loc.longitude)}<br />{coordLabel(loc)}</>
            ) : (
              '坐标待补充'
            )}
          </div>
          {obs.trip && (
            <p class="side-link" style="margin-bottom: 0;">
              来自调查 <a href={withBase(`/trips/${obs.trip.slug}/`)} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">{obs.trip.title} →</a>
            </p>
          )}
        </section>

        {traits.some(([, v]) => v) && (
          <section class="side-block">
            <h3 class="side-kicker">观 察</h3>
            <div class="side-list">
              {traits.filter(([, v]) => v).map(([k, v]) => (
                <div class="row"><span class="k">{k}</span><span>{v}</span></div>
              ))}
            </div>
          </section>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-bottom: 70px;">
        <div class="section-head"><h2>相关记录</h2></div>
        <div class="card-grid">
          {related.map((o) => <ObsCard obs={o} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  // Hero Lightbox：astro:page-load 生命周期（客户端导航后自动重连）
  let heroBox: HTMLElement | null = null;

  function openHero() {
    heroBox = document.getElementById('hero-lightbox');
    if (!heroBox) return;
    heroBox.classList.add('open');
    document.body.style.overflow = 'hidden';
    heroBox.querySelector('.close')?.focus();
  }
  function closeHero() {
    if (!heroBox) return;
    heroBox.classList.remove('open');
    document.body.style.overflow = '';
    heroBox = null;
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (heroBox) {
      if (t.closest('#hero-lightbox .close') || e.target === heroBox) return closeHero();
      return;
    }
    if (t.closest('#hero-open')) openHero();
  });
  document.addEventListener('keydown', (e) => {
    if (!heroBox) return;
    if (e.key === 'Escape') closeHero();
  });
</script>
