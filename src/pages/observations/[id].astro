---
import Base from '../../layouts/Base.astro';
import SciName from '../../components/SciName.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import ObsCard from '../../components/ObsCard.astro';
import { getObservation, allPublicObservations } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { SEX_ZH, LIFE_STAGE_ZH, LOCATION_VISIBILITY_ZH } from '../../lib/labels';
import { formatDate, coordLabel, locationLine, sciNameHtml } from '../../lib/format';

export function getStaticPaths() {
  return allPublicObservations.map((o) => ({ params: { id: o.public_id } }));
}

const { id } = Astro.params;
const obs = getObservation(id!);
if (!obs) return Astro.redirect(withBase('/observations/'));
const loc = obs.location;

const meta: [string, string | null][] = [
  ['性别', SEX_ZH[obs.sex as keyof typeof SEX_ZH] ?? null],
  ['龄期', LIFE_STAGE_ZH[obs.life_stage as keyof typeof LIFE_STAGE_ZH] ?? null],
  ['生境', obs.habitat],
  ['小生境', obs.microhabitat],
  ['行为', obs.behavior],
  ['海拔', loc.elevation_m != null ? `约 ${loc.elevation_m} m` : null],
];

const related = allPublicObservations
  .filter(
    (o) =>
      o.public_id !== obs.public_id &&
      (o.identification?.display === obs.identification?.display ||
        o.trip?.slug === obs.trip?.slug ||
        o.location.state_province === obs.location.state_province),
  )
  .slice(0, 3);
---

<Base title={`${obs.identification?.display ?? '未鉴定的跳蛛'} · ${obs.public_id}`} description={obs.field_note.slice(0, 80)}>
  <div class="obs-hero">
    {obs.cover && <img src={obs.cover.large} alt={obs.cover.caption ?? obs.public_id} fetchpriority="high" />}
  </div>
  <div class="strip"></div>

  <div class="container">
    <header class="obs-title">
      <div class="pub-id">{obs.public_id}</div>
      <h1>
        {obs.identification ? (
          <span set:html={sciNameHtml(obs.identification.display, obs.identification.taxon_rank)} />
        ) : (
          <span>未鉴定的跳蛛</span>
        )}
      </h1>
      <div class="byline">
        {formatDate(obs.observed_at, obs.observed_at_precision)} · {locationLine(loc)}
        {loc.elevation_m != null && ` · 海拔约 ${loc.elevation_m} m`}
        <br />
        观察者 {obs.observer_name}
      </div>
    </header>

    <div class="obs-body">
      <article>
        <section class="field-note">
          <div class="label">野 外 笔 记</div>
          {obs.field_note.split('\n').map((p) => <p>{p}</p>)}
        </section>

        {obs.media.length > 0 && (
          <section style="margin-top: 26px;">
            <MediaGallery media={obs.media} />
          </section>
        )}

        <section class="side-block" style="margin-top: 30px;">
          <h3>鉴 定</h3>
          {obs.identification ? (
            <div class="kv">
              <div class="row">
                <span class="k">当前鉴定</span>
                <span class="v">
                  <SciName display={obs.identification.display} rank={obs.identification.taxon_rank} />
                  <EvidenceBadge evidence={obs.identification.evidence} />
                </span>
              </div>
              <div class="row">
                <span class="k">鉴定人</span>
                <span class="v">{obs.identification.identified_by}（{obs.identification.identified_at}）</span>
              </div>
              {obs.identification.remarks && (
                <div class="row"><span class="k">备注</span><span class="v">{obs.identification.remarks}</span></div>
              )}
            </div>
          ) : (
            <p class="v" style="font-size: 14px; color: var(--muted); margin: 0;">
              暂无鉴定。未知与存疑的记录同样是有效观察。
            </p>
          )}
          {obs.identification_history.length > 1 && (
            <div class="id-history">
              <details>
                <summary>鉴定历史（{obs.identification_history.length} 条，鉴定可变而记录不变）</summary>
                <ul>
                  {obs.identification_history.map((h) => (
                    <li class={obs.identification && h.identified_at !== obs.identification.identified_at ? 'old' : ''}>
                      {h.identified_at} · <span set:html={sciNameHtml(h.display, h.taxon_rank)} />
                      （{h.evidence}）— {h.identified_by}
                    </li>
                  ))}
                </ul>
              </details>
            </div>
          )}
        </section>

        {obs.specimen && (
          <section class="side-block">
            <h3>标 本</h3>
            <div class="kv">
              <div class="row"><span class="k">馆藏号</span><span class="v">{obs.specimen.catalog_number}</span></div>
              <div class="row"><span class="k">保存</span><span class="v">{obs.specimen.repository}{obs.specimen.preservation ? ` · ${obs.specimen.preservation}` : ''}</span></div>
              {obs.specimen.notes && <div class="row"><span class="k">备注</span><span class="v">{obs.specimen.notes}</span></div>}
            </div>
          </section>
        )}
      </article>

      <aside>
        <section class="side-block">
          <h3>时 间</h3>
          <div class="kv"><div class="row"><span class="k">日期</span><span class="v">{formatDate(obs.observed_at, obs.observed_at_precision)}</span></div></div>
        </section>

        <section class="side-block">
          <h3>地 点</h3>
          <div class="kv">
            <div class="row"><span class="k">地区</span><span class="v">{locationLine(loc)}</span></div>
            {loc.elevation_m != null && (
              <div class="row"><span class="k">海拔</span><span class="v">约 {loc.elevation_m} m</span></div>
            )}
            <div class="row"><span class="k">坐标</span>
              <span class="v">
                {loc.latitude != null && loc.longitude != null ? (
                  <>{loc.latitude.toFixed(2)}, {loc.longitude.toFixed(2)}<br /><small style="color: var(--faint);">{coordLabel(loc)}</small></>
                ) : (
                  <small style="color: var(--faint);">{LOCATION_VISIBILITY_ZH[loc.visibility]}</small>
                )}
              </span>
            </div>
          </div>
        </section>

        {meta.some(([, v]) => v) && (
          <section class="side-block">
            <h3>观 察</h3>
            <div class="kv">
              {meta.filter(([, v]) => v).map(([k, v]) => (
                <div class="row"><span class="k">{k}</span><span class="v">{v}</span></div>
              ))}
            </div>
          </section>
        )}

        {obs.trip && (
          <section class="side-block">
            <h3>来 自 调 查</h3>
            <a href={withBase(`/trips/${obs.trip.slug}/`)} style="font-size: 14.5px;">{obs.trip.title} →</a>
          </section>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-bottom: 70px;">
        <div class="section-head"><h2>相关记录</h2></div>
        <div class="card-grid">
          {related.map((o) => <ObsCard obs={o} />)}
        </div>
      </section>
    )}
  </div>
</Base>
