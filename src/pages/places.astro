---
import Base from '../layouts/Base.astro';
import { getLocalityCards } from '../lib/queries';
import { LOCATION_VISIBILITY_ZH } from '../lib/labels';

const cards = getLocalityCards();
const byProvince = new Map<string, typeof cards>();
for (const c of cards) {
  const list = byProvince.get(c.province) ?? [];
  list.push(c);
  byProvince.set(c.province, list);
}
---

<Base title="地点" description="按省份与地点浏览观察记录。敏感情形只公开到地名，甚至完全保密。">
  <div class="container-wide">
    <div class="page-title" style="padding: 44px 0 6px;">
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 4vw, 40px); margin: 0;">地点</h1>
      <p class="lede" style="color: var(--muted); margin: 10px 0 0; max-width: 640px; font-size: 15px;">
        本站的主角是地方：一片林缘、一段河谷、一面城市里的老墙。
      </p>
    </div>

    <div class="place-groups">
      {[...byProvince.entries()].map(([province, list]) => (
        <section class="place-group">
          <h2>{province}<span class="n">{list.reduce((n, c) => n + c.count, 0)} 次相遇</span></h2>
          <div class="place-cards">
            {list.map((c) => (
              <div class="place-card">
                <div class="frame">{c.cover && <img src={c.cover.medium} alt={c.name} loading="lazy" />}</div>
                <div class="name">{c.locality ?? c.county ?? province}</div>
                <div class="meta">
                  {c.county ?? province}
                  {c.elevation != null && ` · 海拔约 ${c.elevation} m`}
                  {` · ${c.count} 次相遇`}
                  {` · ${LOCATION_VISIBILITY_ZH[c.visibilityLabel as keyof typeof LOCATION_VISIBILITY_ZH]}`}
                </div>
                {c.habitats.length > 0 && <div class="habitats">{c.habitats.join(' / ')}</div>}
              </div>
            ))}
          </div>
        </section>
      ))}
      <p class="place-legend">
        隐私图例：{Object.values(LOCATION_VISIBILITY_ZH).join(' / ')}。敏感坐标在数据层就被拦截，不会发送到浏览器——模糊化从不依赖前端脚本。本页仅显示本站实际记录，不代表任何物种的完整分布；具体观察请到「观察」页按永久编号检索。
      </p>
    </div>
  </div>
</Base>
