---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/queries';
import PictureImage from '../../components/PictureImage.astro';
import { formatDate } from '../../lib/format';
import { withBase } from '../../lib/privacy';

const posts = getPublishedPosts();
---

<Base title="札记" description="关于跳蛛、野外与自然史的记录文字。">
  <div class="container">
    <div class="page-title">
      <h1>野外笔记</h1>
      <p class="lede">野外考察的过程、拍摄的方法、观察的心得——大家在这里记录与分享。</p>
    </div>

    {posts.length > 0 ? (
      <div class="post-list" style="padding: 30px 0 70px;">
        {/* 头版：最新一篇大图呈现（§73） */}
        <a class="post-featured" href={withBase(`/posts/${posts[0].slug}/`)}>
          {posts[0].cover && <div class="cover"><PictureImage media={posts[0].cover} sizes="(max-width: 1080px) 100vw, 1080px" alt={posts[0].title} /></div>}
          <div class="body">
            <div class="kicker">最新</div>
            <h2>{posts[0].title}</h2>
            {posts[0].subtitle && <p class="dek">{posts[0].subtitle}</p>}
            <div class="meta">{formatDate(posts[0].created_at.slice(0, 10), 'day')} · {posts[0].author}</div>
            <p class="excerpt" set:html={posts[0].bodyHtml.replace(/<[^>]+>/g, ' ').trim().slice(0, 150) + '…'} />
          </div>
        </a>
        {posts.length > 1 && <div class="post-rows">
          {posts.slice(1).map((p) => (
            <a class="post-card" href={withBase(`/posts/${p.slug}/`)}>
              {p.cover && <div class="cover"><PictureImage media={p.cover} sizes="(max-width: 700px) 30vw, 240px" alt={p.title} /></div>}
              <div class="body">
                <h2>{p.title}</h2>
                <div class="meta">{formatDate(p.created_at.slice(0, 10), 'day')} · {p.author}</div>
                <p class="excerpt" set:html={p.bodyHtml.replace(/<[^>]+>/g, ' ').trim().slice(0, 100) + '…'} />
              </div>
            </a>
          ))}
        </div>}
      </div>
    ) : (
      <div class="empty-state" style="margin-bottom: 80px;">还没有已发布的札记。</div>
    )}
  </div>
</Base>

<style>
  .post-list { display: flex; flex-direction: column; gap: var(--s-8); }
  /* 头版（§73）：大图 + 大标题 + 摘要 */
  .post-featured { display: block; text-decoration: none; color: inherit; }
  .post-featured .cover { max-width: var(--content); overflow: hidden; background: var(--paper-deep); aspect-ratio: 16 / 8; }
  .post-featured .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-featured .body { max-width: 720px; padding-top: var(--s-5); }
  .post-featured .kicker { font-size: 12.5px; font-weight: 600; letter-spacing: 0.1em; color: var(--terra); }
  .post-featured h2 {
    font-family: var(--serif); font-size: clamp(26px, 3.4vw, 38px); font-weight: 700;
    letter-spacing: 0.03em; margin: var(--s-2) 0 0; line-height: 1.3;
  }
  .post-featured .dek { color: var(--muted); font-size: 16px; margin: var(--s-2) 0 0; }
  .post-featured .meta { font-size: 12.5px; color: var(--faint); letter-spacing: 0.06em; margin: var(--s-3) 0; }
  .post-featured .excerpt { color: var(--ink); font-size: 15.5px; line-height: 1.95; margin: 0; }
  /* 其余：横向编辑行（§74） */
  .post-rows { display: flex; flex-direction: column; gap: var(--s-7); padding-top: var(--s-6); border-top: 1px solid var(--line-soft); }
  .post-card { display: grid; grid-template-columns: 240px 1fr; gap: var(--s-5); align-items: start; }
  .post-card .cover { aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-deep); }
  .post-card .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .post-card:hover .cover img { transform: scale(1.03); }
  .post-card h2 { font-family: var(--serif); font-size: 22px; font-weight: 700; letter-spacing: 0.02em; margin: 0 0 6px; }
  .post-card .meta { font-size: 12.5px; color: var(--faint); letter-spacing: 0.06em; margin-bottom: 10px; }
  .post-card .excerpt { color: var(--muted); font-size: 14.5px; margin: 0; }
  @media (max-width: 700px) { .post-card { grid-template-columns: 1fr; } .post-featured .cover { aspect-ratio: 4 / 3; } }
</style>
