---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/queries';
import PictureImage from '../../components/PictureImage.astro';
import { formatDate } from '../../lib/format';
import { withBase } from '../../lib/privacy';

const posts = getPublishedPosts();
const [featured, ...rest] = posts;

function excerptOf(p: (typeof posts)[number]): string {
  return p.bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 140);
}
---

<Base title="札记" description="比一条观察记录更长一些的东西：野外故事、拍摄方法、物种心得与鉴定经验。">
  <div class="container">
    <div class="page-title">
      <h1>札记</h1>
      <p class="lede">比一条观察记录更长一些的东西。</p>
    </div>

    {posts.length > 0 ? (
      <div class="journal" style="padding: 30px 0 70px;">
        {featured && (
          <a class={`journal-featured ${featured.cover ? 'has-cover' : 'text-only'}`} href={withBase(`/posts/${featured.slug}/`)}>
            <div class="feat-kicker">最新一期</div>
            {featured.cover && (
              <div class="cover"><PictureImage media={featured.cover} sizes="(max-width: 1080px) 100vw, 1080px" alt={featured.title} /></div>
            )}
            <div class="body">
              <h2>{featured.title}</h2>
              {featured.subtitle && <p class="dek">{featured.subtitle}</p>}
              <div class="meta">{formatDate(featured.created_at.slice(0, 10), 'day')} · {featured.author}</div>
              <p class="excerpt">{excerptOf(featured)}</p>
              <span class="read">阅读全文 →</span>
            </div>
          </a>
        )}

        {rest.length > 0 && (
          <div class="journal-rows">
            <div class="rows-kicker">往 期</div>
            {rest.map((p) => (
              <a class={`journal-row ${p.cover ? '' : 'text-only'}`} href={withBase(`/posts/${p.slug}/`)}>
                {p.cover && (
                  <div class="thumb"><PictureImage media={p.cover} sizes="(max-width: 700px) 30vw, 200px" alt={p.title} /></div>
                )}
                <div class="body">
                  <h2>{p.title}</h2>
                  {p.subtitle && <p class="dek">{p.subtitle}</p>}
                  <div class="meta">{formatDate(p.created_at.slice(0, 10), 'day')} · {p.author}</div>
                  <p class="excerpt">{excerptOf(p)}</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="empty-state" style="margin-bottom: 80px;">还没有已发布的札记。</div>
    )}
  </div>
</Base>

<style>
  /* ---- 自然史刊物目录：Typography + Whitespace，不用卡片（§13） ---- */
  .journal { display: flex; flex-direction: column; gap: var(--s-8); }
  /* 杂志刊头条：本期头条 */
  .feat-kicker {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.18em; color: var(--terra);
    margin-bottom: var(--s-3);
  }
  .feat-kicker::after { content: ''; width: 34px; height: 1px; background: var(--terra); opacity: 0.6; }
  /* 往期分隔条 */
  .rows-kicker {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; font-weight: 600; letter-spacing: 0.22em; color: var(--faint);
  }
  .rows-kicker::after { content: ''; flex: 1; height: 1px; background: var(--line-soft); }

  /* Featured（§2）：大图可选；无图时纯文字排版同样成立（§7） */
  .journal-featured { display: block; text-decoration: none; color: inherit; }
  .journal-featured .cover { overflow: hidden; background: var(--paper-deep); aspect-ratio: 16 / 8; }
  .journal-featured .cover :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s var(--ease-out, ease); }
  .journal-featured:hover .cover :global(img) { transform: scale(1.015); }
  .journal-featured .body { max-width: 720px; padding-top: var(--s-5); }
  .journal-featured.text-only .body { padding-top: 0; }
  .journal-featured h2 {
    font-family: var(--serif); font-size: clamp(30px, 4vw, 46px); font-weight: 700;
    letter-spacing: 0.04em; line-height: 1.28; margin: var(--s-2) 0 0;
  }
  .journal-featured.text-only h2 { font-size: clamp(32px, 4vw, 46px); }
  .journal-featured .dek { color: var(--muted); font-size: clamp(15.5px, 1.8vw, 18px); margin: var(--s-2) 0 0; line-height: 1.8; }
  .journal-featured .meta { font-size: 12.5px; color: var(--faint); letter-spacing: 0.06em; margin: var(--s-3) 0; }
  .journal-featured .excerpt {
    color: var(--ink); font-size: 15.5px; line-height: 1.95; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .journal-featured .read {
    display: inline-block; margin-top: var(--s-3);
    font-size: 14px; color: var(--muted); text-decoration: none;
  }
  .journal-featured:hover .read { color: var(--terra); }

  /* 其余：简洁横向 editorial list；无图行退化为纯文字（§2/§7） */
  .journal-rows { display: flex; flex-direction: column; gap: var(--s-6); padding-top: var(--s-5); border-top: 1px solid var(--line-soft); }
  .journal-row { display: grid; grid-template-columns: 200px 1fr; gap: var(--s-5); align-items: start; text-decoration: none; color: inherit; }
  .journal-row.text-only { grid-template-columns: 1fr; }
  .journal-row .thumb { overflow: hidden; aspect-ratio: 3 / 2; background: var(--paper-deep); }
  .journal-row .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .journal-row:hover .thumb :global(img) { transform: scale(1.02); }
  .journal-row h2 {
    font-family: var(--serif); font-size: 19px; font-weight: 700; letter-spacing: 0.02em;
    margin: 0; line-height: 1.5; color: var(--ink);
  }
  .journal-row:hover h2 { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  .journal-row .dek { color: var(--muted); font-size: 14.5px; margin: 4px 0 0; }
  .journal-row .meta { font-size: 12.5px; color: var(--faint); letter-spacing: 0.06em; margin: 6px 0; }
  .journal-row .excerpt {
    color: var(--muted); font-size: 13.5px; line-height: 1.8; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* ---- Mobile（§14）---- */
  @media (max-width: 700px) {
    .journal { gap: var(--s-8); }
    .journal-featured .cover { aspect-ratio: 4 / 3; }
    .journal-row { grid-template-columns: 1fr; gap: var(--s-3); }
    .journal-row .thumb { aspect-ratio: 16 / 9; }
    .journal-row .thumb :global(img) { width: 100%; }
  }
</style>
