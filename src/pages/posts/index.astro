---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { withBase } from '../../lib/privacy';

const posts = getPublishedPosts();
---

<Base title="观察博文" description="关于跳蛛、野外与自然史的记录文字。">
  <div class="container">
    <div class="page-title" style="padding: 44px 0 6px;">
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 4vw, 40px); margin: 0;">观察博文</h1>
      <p class="lede" style="color: var(--muted); margin: 10px 0 0; max-width: 680px; font-size: 15px;">
        观察记录之外 longer 的文字：野外故事、鉴定笔记、某个物种教会我们的事。
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="post-list" style="padding: 30px 0 70px;">
        {posts.map((p) => (
          <a class="post-card" href={withBase(`/posts/${p.slug}/`)}>
            {p.cover && <div class="cover"><img src={p.cover.medium} alt={p.title} loading="lazy" /></div>}
            <div class="body">
              <h2>{p.title}</h2>
              <div class="meta">{formatDate(p.created_at.slice(0, 10), 'day')} · {p.author}</div>
              <p class="excerpt" set:html={p.bodyHtml.replace(/<[^>]+>/g, ' ').slice(0, 120) + '…'} />
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state" style="margin-bottom: 80px;">还没有已发布的博文。</div>
    )}
  </div>
</Base>

<style>
  .post-list { display: flex; flex-direction: column; gap: 40px; }
  .post-card { display: grid; grid-template-columns: 280px 1fr; gap: 26px; align-items: start; }
  .post-card .cover { aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-deep); }
  .post-card .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .post-card:hover .cover img { transform: scale(1.03); }
  .post-card h2 { font-family: var(--serif); font-size: 24px; font-weight: 400; margin: 0 0 6px; }
  .post-card .meta { font-size: 12.5px; color: var(--faint); letter-spacing: 0.06em; margin-bottom: 10px; }
  .post-card .excerpt { color: var(--muted); font-size: 14.5px; margin: 0; }
  @media (max-width: 700px) { .post-card { grid-template-columns: 1fr; } }
</style>
