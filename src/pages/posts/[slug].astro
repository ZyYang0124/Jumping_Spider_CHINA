---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublishedPost, getPublishedPosts } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  return getPublishedPosts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPublishedPost(slug!);
if (!post) return Astro.redirect(withBase('/posts/'));
---

<Base title={post.title} description={post.bodyHtml.replace(/<[^>]+>/g, ' ').slice(0, 90)}>
  <article class="story">
    <header class="story-hero">
      <div class="hero-kicker">札 记</div>
      <h1 class="hero-title">{post.title}</h1>
      {post.subtitle && <p class="hero-dek">{post.subtitle}</p>}
      <div class="hero-meta">
        <span>{formatDate(post.created_at.slice(0, 10), 'day')}</span>
        <span class="meta-dot"></span>
        <span>{post.author}</span>
      </div>
    </header>

    {post.cover && (
      <figure class="story-cover">
        <img src={post.cover.large} alt={post.title} fetchpriority="high" />
      </figure>
    )}

    <div class="story-body post-body" set:html={post.bodyHtml} />

    {post.relatedObservations.length > 0 && (
      <section class="story-related">
        <h2 class="related-kicker">文 中 观 察</h2>
        <div class="side-secondary">
          {post.relatedObservations.map((o) => (
            <div><a href={o.url} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">{o.public_id}</a> · {o.display ?? '未鉴定的跳蛛'}</div>
          ))}
        </div>
      </section>
    )}

    <p class="back-link"><a href={withBase('/posts/')}>← 全部札记</a></p>
  </article>
</Base>

<style>
  /* 札记排版：杂志式刊头 + 740px 衬线正文 + 图片跳出文本栏（参考自然史故事页结构） */
  .story { max-width: 1080px; margin: 0 auto; padding: 8px 24px 70px; }

  /* ---- 刊头 ---- */
  .story-hero { text-align: center; max-width: 760px; margin: 44px auto 40px; }
  .hero-kicker {
    font-family: var(--sans); font-size: 12px; font-weight: 600;
    letter-spacing: 0.35em; text-indent: 0.35em; color: var(--terra);
    margin: 0 0 24px;
  }
  .hero-title {
    font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 2.85rem);
    font-weight: 700; letter-spacing: 0.1em; text-indent: 0.1em;
    line-height: 1.35; margin: 0 0 18px;
  }
  .hero-dek {
    letter-spacing: 0.08em; color: var(--muted);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem); margin: 0 0 24px;
  }
  .hero-meta {
    display: flex; justify-content: center; align-items: center; gap: 10px;
    font-size: 13px; color: var(--faint); letter-spacing: 0.06em;
  }
  .meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--faint); }

  /* ---- 封面大图：通栏 ---- */
  .story-cover { margin: 0 auto 8px; max-width: min(100%, 1080px); }
  .story-cover img { width: 100%; height: auto; display: block; }

  /* ---- 正文：740px 衬线阅读栏 ---- */
  .story-body {
    max-width: 740px; margin: 0 auto;
    font-family: var(--serif); font-size: 16.5px; line-height: 2.05; color: var(--ink);
  }
  .story-body :global(p) { margin: 0 0 1.55em; text-align: justify; }
  /* 小节标题 = 居中章节分隔：字距拉开 + 短线（红栏杆 motif 的克制用法） */
  .story-body :global(h2) {
    text-align: center; font-family: var(--serif); font-size: 1.3rem; font-weight: 700;
    letter-spacing: 0.2em; text-indent: 0.2em; color: var(--ink);
    margin: 3em 0 1.8em;
  }
  .story-body :global(h2)::after {
    content: ''; display: block; width: 26px; height: 2px;
    background: var(--terra); opacity: 0.75; margin: 16px auto 0;
  }
  .story-body :global(h3) {
    font-size: 17px; letter-spacing: 0.06em; margin: 2em 0 0.8em; color: var(--ink);
  }
  .story-body :global(blockquote) {
    margin: 1.8em 0; padding: 6px 20px; border-left: 2px solid var(--line);
    color: var(--muted);
  }
  .story-body :global(code) { background: var(--paper-deep); padding: 1px 6px; font-size: 0.85em; }

  /* ---- 图片：跳出 740px 文本栏，居中，上限 1080px / 80vh；不裁切 ---- */
  .story-body :global(img) {
    display: block; margin: 2em auto; max-width: min(100%, 1080px);
    height: auto; max-height: 80vh;
  }
  .story-body :global(figure) { margin: 2.4em auto; max-width: min(100%, 1080px); }
  .story-body :global(figure img) { margin: 0 auto; max-height: 80vh; }
  .story-body :global(figcaption) {
    text-align: center; font-family: var(--sans); font-size: 12.5px;
    line-height: 1.7; color: var(--muted); margin-top: 10px;
  }
  /* 连续图片组合 */
  .story-body :global(.article-media),
  .story-body :global(.article-media-group),
  .story-body :global(.article-media-group figure) { margin: 2.4em auto; }
  .story-body :global(.article-media-group) { display: grid; gap: 12px; max-width: min(100%, 1080px); }
  .story-body :global(.amg-pair) { grid-template-columns: 1fr 1fr; }
  .story-body :global(.amg-triptych) { grid-template-columns: 1fr 1fr 1fr; }
  .story-body :global(.amg-grid4), .story-body :global(.amg-grid) { grid-template-columns: 1fr 1fr; }
  .story-body :global(.am-portrait) { max-width: min(74%, 560px); margin-inline: auto; }
  .story-body :global(.am-panorama) { max-width: none; }
  .story-body :global(.article-media-group img) { max-height: 76vh; }
  .story-body :global(.article-media-group figcaption),
  .story-body :global(.am figcaption) { margin-top: 8px; }
  /* 观察嵌入卡：居中、安静 */
  .story-body :global(.article-embed) {
    border: 1px solid var(--line); background: #fff; border-radius: 12px;
    padding: 14px 18px; margin: 2.2em auto; max-width: 560px;
    font-family: var(--sans); font-size: 14px;
  }
  .story-body :global(.article-embed.is-missing) { color: var(--terra); }
  .story-body :global(.article-embed a) { display: flex; gap: 14px; align-items: center; text-decoration: none; }
  .story-body :global(.article-embed img) {
    width: 76px; height: 76px; object-fit: cover; border-radius: 8px; margin: 0; flex: none;
  }
  .story-body :global(.embed-body) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .story-body :global(.embed-id) { color: var(--faint); font-size: 12px; display: block; letter-spacing: 0.04em; }
  .story-body :global(.embed-body strong) { font-weight: 600; }
  .story-body :global(.embed-body span) { color: var(--muted); font-size: 13px; }

  /* ---- 文中观察 ---- */
  .story-related { max-width: 740px; margin: 3.5em auto 0; }
  .related-kicker {
    font-family: var(--sans); font-size: 12px; font-weight: 600;
    letter-spacing: 0.3em; color: var(--muted); margin: 0 0 16px;
  }
  .side-secondary { font-size: 14.5px; line-height: 2.1; color: var(--ink); }
  .back-link { max-width: 740px; margin: 3em auto 0; font-size: 14px; color: var(--muted); }
  .back-link a { color: var(--muted); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .back-link a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .story { padding: 4px 18px 56px; }
    .story-hero { margin: 28px auto 30px; }
    .hero-title { letter-spacing: 0.06em; text-indent: 0.06em; }
    .story-body :global(.amg-triptych) { grid-template-columns: 1fr; }
    .story-body :global(.am-portrait) { max-width: 100%; }
  }
</style>
