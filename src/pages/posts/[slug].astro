---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublishedPost, getPublishedPosts } from '../../lib/queries';
import { withBase } from '../../lib/privacy';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  return getPublishedPosts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPublishedPost(slug!);
if (!post) return Astro.redirect(withBase('/posts/'));
---

<Base title={post.title} description={post.bodyHtml.replace(/<[^>]+>/g, ' ').slice(0, 90)}>
  <article class="container-narrow">
    <div class="page-title" style="padding: 48px 0 6px;">
      <div class="kicker on-paper">札 记</div>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 5vw, 46px); margin: 10px 0 8px; letter-spacing: -0.01em;">{post.title}</h1>
      {post.subtitle && <p style="color: var(--muted); font-size: 16px; margin: 0 0 6px;">{post.subtitle}</p>}
      <div class="byline" style="color: var(--muted); font-size: 14px;">
        {formatDate(post.created_at.slice(0, 10), 'day')} · {post.author}
      </div>
    </div>

    {post.cover && (
      <figure style="margin: 26px 0 8px;">
        <img src={post.cover.large} alt={post.title} style="width: 100%; height: auto;" fetchpriority="high" />
      </figure>
    )}

    <div class="post-body" set:html={post.bodyHtml} />

    {post.relatedObservations.length > 0 && (
      <section class="side-block" style="margin-top: 44px;">
        <h3 class="side-kicker">相 关 观 察</h3>
        <div class="side-secondary">
          {post.relatedObservations.map((o) => (
            <div><a href={o.url} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">{o.public_id}</a> · {o.display ?? '未鉴定的跳蛛'}</div>
          ))}
        </div>
      </section>
    )}

    <p style="padding-bottom: 60px; margin-top: 40px;"><a href={withBase('/posts/')} style="text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;">← 全部札记</a></p>
  </article>
</Base>

<style>
  .post-body { font-size: 17px; line-height: 2.05; padding-top: 14px; }
  .post-body :global(p) { margin: 0 0 1.25em; text-align: justify; }
  .post-body :global(h2) { font-family: var(--serif); font-size: 22px; font-weight: 700; margin: 1.6em 0 0.6em; }
  .post-body :global(h3) { font-size: 18px; margin: 1.4em 0 0.5em; }
  .post-body :global(img) { margin: 8px 0; }
  .post-body :global(blockquote) {
    margin: 1.4em 0; padding: 4px 20px; border-left: 3px solid var(--accent);
    background: var(--paper-deep); color: var(--muted);
  }
  .post-body :global(code) { background: var(--paper-deep); padding: 1px 6px; font-size: 0.85em; }

  /* ---- Article Engine（Studio 导出正文）的布局语义 ---- */
  /* 单图与方向层级：竖幅收窄居中，横幅通栏 */
  .post-body :global(.article-media) { margin: 26px 0; }
  .post-body :global(.article-media figure), .post-body :global(.article-media-group figure) { margin: 0; }
  .post-body :global(.article-media img), .post-body :global(.article-media-group img) { margin: 0; }
  .post-body :global(.am) { margin: 26px 0; }
  .post-body :global(.am-portrait) { max-width: 62%; margin-inline: auto; }
  .post-body :global(.am-panorama) { max-width: none; }
  /* 连续图片组合：数量决定网格 */
  .post-body :global(.article-media-group) { display: grid; gap: 12px; margin: 26px 0; }
  .post-body :global(.amg-pair) { grid-template-columns: 1fr 1fr; }
  .post-body :global(.amg-triptych) { grid-template-columns: 1fr 1fr 1fr; }
  .post-body :global(.amg-grid4), .post-body :global(.amg-grid) { grid-template-columns: 1fr 1fr; }
  @media (max-width: 640px) {
    .post-body :global(.amg-triptych) { grid-template-columns: 1fr; }
  }
  .post-body :global(figcaption) {
    font-family: var(--sans); font-size: 12.5px; line-height: 1.6;
    color: var(--muted); margin-top: 8px;
  }
  /* 观察嵌入卡片 */
  .post-body :global(.article-embed) {
    border: 1px solid var(--line); background: #fff; border-radius: 12px;
    padding: 14px 18px; margin: 22px 0; font-family: var(--sans); font-size: 14px;
  }
  .post-body :global(.article-embed.is-missing) { color: var(--terra); }
  .post-body :global(.article-embed a) { display: flex; gap: 14px; align-items: center; text-decoration: none; }
  .post-body :global(.article-embed img) {
    width: 84px; height: 84px; object-fit: cover; border-radius: 8px; margin: 0; flex: none;
  }
  .post-body :global(.embed-body) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .post-body :global(.embed-id) { color: var(--faint); font-size: 12px; display: block; letter-spacing: 0.04em; }
  .post-body :global(.embed-body strong) { font-weight: 600; }
  .post-body :global(.embed-body span) { color: var(--muted); font-size: 13px; }
</style>
