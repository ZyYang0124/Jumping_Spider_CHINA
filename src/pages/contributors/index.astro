---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { getPublicContributors } from '../../lib/queries';
import PictureImage from '../../components/PictureImage.astro';
import { withBase } from '../../lib/privacy';

const contributors = getPublicContributors();
---

<Base title="伙伴" description="跳蛛观察志的站长与受邀伙伴。">
  <div class="container-wide">
    <div class="page-title" style="padding: 44px 0 6px;">
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 4vw, 40px); margin: 0;">伙伴</h1>
      <p class="lede" style="color: var(--muted); margin: 10px 0 0; max-width: 640px; font-size: 15px;">
        观察属于每一个在野外蹲下身来的人。本站采用邀请制投稿——朋友的材料经站长审核、鉴定后发布。
      </p>
    </div>
    <div class="contributor-grid" style="padding-bottom: 70px;">
      {contributors.map((c) => (
        <a class="contributor-card" href={withBase(`/contributors/${c.slug}/`)}>
          <div class="cover">{c.favorite && <PictureImage media={c.favorite} sizes="(max-width: 700px) 92vw, 320px" alt={`${c.name} 代表照片`} />}</div>
          <div class="body">
            <h2>{c.name}</h2>
            {c.title && <div class="title">{c.title}</div>}
            {c.bio && <p class="bio">{c.bio}</p>}
            <div class="stats">
              {c.observationCount} 次观察
              {c.regions.length > 0 && <span class="pv"> · {c.regions.join(' · ')}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
