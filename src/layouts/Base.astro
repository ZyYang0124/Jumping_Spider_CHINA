---
import '../styles/global.css';
import EightEyes from '../components/EightEyes.astro';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../lib/store';
import { withBase } from '../lib/privacy';

interface Props {
  title?: string;
  description?: string;
  /** 首页 Hero LCP 预加载（仅首页传入） */
  preload?: { href: string; imagesrcset?: string; imagesizes?: string };
}

const { title, description = siteConfig.subtitle, preload } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.site_name}` : `${siteConfig.site_name} | ${siteConfig.site_name_en}`;

const nav = [
  { href: '/observations/', label: '观察' },
  { href: '/trips/', label: '野外调查' },
  { href: '/species/', label: '物种' },
  { href: '/media/', label: '影像' },
  { href: '/posts/', label: '札记' },
  { href: '/places/', label: '地点' },
  { href: '/contributors/', label: '伙伴' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    )}
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist>
      <div class="inner">
        <a class="brand" href={withBase('/')}>
          <span class="zh">{siteConfig.site_name}</span>
          <span class="en">{siteConfig.site_name_en}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="mark"><EightEyes size={34} /></div>
        <div class="fn">{siteConfig.site_name}</div>
        <div class="fen">{siteConfig.site_name_en}</div>
        <p class="motto">一个关于相遇、观察与自然史的个人策展项目。</p>
        <p class="legal">
          © {new Date().getFullYear()} {siteConfig.copyright_holder}
          <span class="sep">·</span>
          <a href="https://github.com/ZyYang0124/Salticid_Notes" rel="noopener">GitHub</a>
          <span class="sep">·</span>
          <a href={withBase('/about/#colophon')}>Colophon</a>
        </p>
      </div>
    </footer>
  </body>
</html>
