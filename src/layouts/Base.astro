---
import '../styles/global.css';
import EightEyes from '../components/EightEyes.astro';
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../lib/store';
import { withBase } from '../lib/privacy';

interface Props {
  title?: string;
  description?: string;
  /** 首页 Hero LCP 预加载（仅首页传入） */
  preload?: { href: string; imagesrcset?: string; imagesizes?: string };
  /** Open Graph 预览图（相对路径，如 /media/derivatives/...） */
  ogImage?: string;
}

const { title, description = siteConfig.subtitle, preload, ogImage } = Astro.props;
const SITE_URL = 'https://salticidnotes.cn';
const ogImageAbs = ogImage ? SITE_URL + withBase(ogImage) : SITE_URL + withBase('/media/derivatives/m-3047463f-1280.jpg');
const pageTitle = title ? `${title} · ${siteConfig.site_name}` : `${siteConfig.site_name} | ${siteConfig.site_name_en}`;

const nav = [
  { href: '/observations/', label: '观察' },
  { href: '/trips/', label: '野外调查' },
  { href: '/species/', label: '物种' },
  { href: '/media/', label: '影像' },
  { href: '/posts/', label: '札记' },
  { href: '/places/', label: '地点' },
  { href: '/contributors/', label: '伙伴' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={SITE_URL + withBase(Astro.url.pathname)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={SITE_URL + withBase(Astro.url.pathname)} />
    <meta name="generator" content={Astro.generator} />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    )}
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist>
      <div class="inner">
        <a class="brand" href={withBase('/')}>
          <span class="zh">{siteConfig.site_name}</span>
          <span class="en">{siteConfig.site_name_en}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((n) => (
            <a
              href={withBase(n.href)}
              aria-current={Astro.url.pathname.replace(/\/$/, '') === n.href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <button class="menu-btn" type="button" aria-label="打开菜单" aria-expanded="false" data-menu-open>
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <!-- 移动端全屏菜单（§23） -->
    <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
      <button class="close" type="button" aria-label="关闭菜单" data-menu-close>×</button>
      {nav.map((n) => <a href={withBase(n.href)} data-menu-link>{n.label}</a>)}
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer" data-railing>
      <div class="inner">
        <div class="mark"><EightEyes size={34} /></div>
        <div class="fn">{siteConfig.site_name}</div>
        <div class="fen">{siteConfig.site_name_en}</div>
        <p class="motto">一个关于相遇、观察与自然史的个人策展项目。</p>
        <p class="legal">
          © {new Date().getFullYear()} {siteConfig.copyright_holder}
          <span class="sep">·</span>
          <a href="https://github.com/ZyYang0124/Salticid_Notes" rel="noopener">GitHub</a>
          <span class="sep">·</span>
          <a href={withBase('/about/#colophon')}>Colophon</a>
        </p>
      </div>
    </footer>

    <!-- Studio 入口：低存在感，仅 corner 一枚（§33） -->
    <a class="studio-entry" href="https://studio.salticidnotes.cn/studio" title="Studio" aria-label="Studio">✎</a>
    <style>
      .studio-entry {
        position: fixed; right: 14px; bottom: 14px; z-index: 60;
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--faint, #948b7d); background: transparent;
        text-decoration: none; font-size: 15px;
        opacity: .55; transition: opacity 180ms ease;
      }
      .studio-entry:hover { opacity: 1; }
      @media print { .studio-entry { display: none; } }
    </style>

  <script>
    // 移动端菜单：开/关 + Esc + 点击链接后关闭
    function initMenu() {
      const btn = document.querySelector('[data-menu-open]');
      const nav = document.getElementById('mobile-nav');
      if (!btn || !nav) return;
      const close = nav.querySelector('[data-menu-close]');
      const setOpen = (open) => {
        nav.hidden = !open;
        nav.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };
      btn.addEventListener('click', () => setOpen(true));
      close?.addEventListener('click', () => setOpen(false));
      nav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-menu-link]')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }
    document.addEventListener('astro:page-load', initMenu);

    // Scroll Reveal：进入视口一次上浮，不做重复动画；reduced-motion 时直接可见。
    function initReveal() {
      const els = document.querySelectorAll('.reveal:not(.is-visible)');
      if (!els.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('is-visible');
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }
    document.addEventListener('astro:page-load', initReveal);
  </script>
  </body>
</html>
