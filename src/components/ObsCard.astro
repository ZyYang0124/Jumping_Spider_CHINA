---
// 观察卡片：照片优先，依次是鉴定、地点、日期
import type { PublicObservation } from '../lib/privacy';
import { formatDate, shortRegion } from '../lib/format';
import SciName from './SciName.astro';

interface Props {
  obs: PublicObservation;
}

const { obs } = Astro.props;
---

<a class="obs-card" href={obs.url}>
  <div class="frame">
    {obs.cover ? (
      <img
        src={obs.cover.thumb}
        alt={obs.cover.caption ?? `${obs.public_id} 的封面照片`}
        loading="lazy"
        width={obs.cover.width}
        height={obs.cover.height}
      />
    ) : (
      <div class="frame-empty" />
    )}
  </div>
  <div class="meta">
    <div class="name">
      {obs.identification ? (
        <SciName display={obs.identification.display} rank={obs.identification.taxon_rank} />
      ) : (
        <span class="no-id">未鉴定的跳蛛</span>
      )}
    </div>
    <div class="sub">
      {formatDate(obs.observed_at, obs.observed_at_precision)} · {shortRegion(obs.location)}
    </div>
  </div>
</a>

<style>
  .frame-empty { width: 100%; height: 100%; }
</style>
