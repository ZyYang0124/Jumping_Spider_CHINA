---
// 顶部搜索框（§108 统一搜索 + 输入预测）：
// 输入即出建议（观察/物种/调查/札记，带缩略图），↑↓ 选择、Enter 跳转、Esc 关闭；
// 空回车或直接提交 → /search/?q= 完整结果页。索引首次聚焦时懒加载。
import { withBase } from '../lib/privacy';
---

<div class="sb" data-searchbox>
  <form action={withBase('/search/')} method="get" role="search">
    <input
      type="search"
      name="q"
      placeholder="搜索…"
      aria-label="全站搜索"
      autocomplete="off"
      aria-expanded="false"
      aria-controls="sb-list"
    />
    <button type="submit" aria-label="搜索">⌕</button>
  </form>
  <ul class="sb-pop" id="sb-list" role="listbox" hidden></ul>
</div>

<script>
  interface IndexItem {
    type: string;
    url: string;
    title: string;
    meta: string;
    text: string;
    thumb: string | null;
  }
  type SearchIndex = { observations: IndexItem[]; species: IndexItem[]; trips: IndexItem[]; posts?: IndexItem[] };

  function initSearchBox() {
    const box = document.querySelector<HTMLElement>('[data-searchbox]');
    if (!box || box.dataset.init === '1') return;
    box.dataset.init = '1';
    const input = box.querySelector<HTMLInputElement>('input[name="q"]')!;
    const pop = box.querySelector<HTMLUListElement>('.sb-pop')!;
    const form = box.querySelector<HTMLFormElement>('form')!;
    let index: IndexItem[] = [];
    let loading = false;
    let active = -1;

    const esc = (s: string) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    async function ensureIndex() {
      if (index.length || loading) return;
      loading = true;
      try {
        const data = (await fetch(`${import.meta.env.BASE_URL}data/search-index.json`).then((r) => r.json())) as SearchIndex;
        index = [...(data.observations ?? []), ...(data.species ?? []), ...(data.trips ?? []), ...(data.posts ?? [])];
      } catch {
        index = [];
      }
      loading = false;
    }

    function close() {
      pop.hidden = true;
      active = -1;
      input.setAttribute('aria-expanded', 'false');
    }

    function render(q: string) {
      const query = q.trim().toLowerCase();
      if (!query) return close();
      const scored = index
        .map((it) => {
          const t = (it.title + ' ' + it.meta).toLowerCase();
          const body = (t + ' ' + it.text).toLowerCase();
          let score = -1;
          if (it.title.toLowerCase().startsWith(query)) score = 3;
          else if (it.title.toLowerCase().includes(query)) score = 2;
          else if (t.includes(query)) score = 1;
          else if (body.includes(query)) score = 0;
          return { it, score };
        })
        .filter((x) => x.score >= 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 7);
      if (!scored.length) {
        pop.innerHTML = '<li class="sb-none">没有匹配——回车看完整搜索</li>';
        pop.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        return;
      }
      pop.innerHTML = scored
        .map(
          ({ it }) =>
            `<li role="option" tabindex="-1"><a href="${it.url}" data-sb-url>` +
            (it.thumb ? `<img src="${it.thumb}" alt="" loading="lazy" />` : '<span class="sb-noimg"></span>') +
            `<span class="sb-t"><span class="sb-title">${esc(it.title)}</span><span class="sb-meta">${esc(it.meta)}</span></span></a></li>`,
        )
        .join('');
      pop.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    }

    function move(dir: 1 | -1) {
      const rows = Array.from(pop.querySelectorAll('li')) as HTMLElement[];
      if (!rows.length || pop.hidden) return;
      active = (active + dir + rows.length) % rows.length;
      rows.forEach((r, i) => r.classList.toggle('on', i === active));
      rows[active].scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('focus', () => {
      ensureIndex().then(() => render(input.value));
    });
    input.addEventListener('input', () => {
      ensureIndex().then(() => render(input.value));
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Escape') { close(); input.blur(); }
      else if (e.key === 'Enter' && active >= 0) {
        const link = pop.querySelectorAll('li')[active]?.querySelector('a[href]') as HTMLAnchorElement | null;
        if (link) { e.preventDefault(); location.href = link.href; }
      }
    });
    // mousedown：在 blur 之前完成跳转
    pop.addEventListener('mousedown', (e) => {
      const link = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
      if (link) { e.preventDefault(); location.href = link.href; }
    });
    document.addEventListener('click', (e) => {
      if (!box.contains(e.target as Node)) close();
    });
    form.addEventListener('submit', () => close());
  }
  document.addEventListener('astro:page-load', initSearchBox);
  initSearchBox();
</script>

<style>
  .sb { position: relative; }
  .sb form { display: flex; align-items: center; gap: 4px; }
  .sb input {
    font: inherit; font-size: 13.5px; color: var(--ink);
    border: none; border-bottom: 1px solid var(--line);
    background: none; outline: none; width: 130px; padding: 4px 2px;
    transition: width 0.18s ease, border-color 0.18s ease;
  }
  .sb input:focus { width: 210px; border-bottom-color: var(--faint); }
  .sb input::placeholder { color: var(--faint); }
  .sb button {
    font: inherit; font-size: 15px; background: none; border: none;
    cursor: pointer; color: var(--muted); padding: 2px;
  }
  .sb button:hover { color: var(--terra); }
  .sb-pop {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 60;
    width: 320px; max-width: 86vw; margin: 0; padding: 6px; list-style: none;
    background: var(--paper); border: 1px solid var(--line); border-radius: 6px;
  }
  .sb-pop :global(li) { border-radius: 4px; }
  .sb-pop :global(li.on) { background: var(--paper-deep); }
  .sb-pop :global(li a) {
    display: flex; gap: 10px; align-items: center;
    padding: 7px 8px; text-decoration: none; color: var(--ink);
  }
  .sb-pop :global(li img),
  .sb-pop :global(li .sb-noimg) {
    width: 34px; height: 34px; object-fit: cover; flex: none;
    background: var(--paper-deep); display: block;
  }
  .sb-pop :global(.sb-t) { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .sb-pop :global(.sb-title) { font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb-pop :global(.sb-title i), .sb-pop :global(.sb-title [data-sci]) { font-family: var(--serif); }
  .sb-pop :global(.sb-meta) { font-size: 11.5px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sb-pop :global(.sb-none) { padding: 10px; font-size: 12.5px; color: var(--faint); }
  /* mobile：顶栏拥挤，收起（首页与 /search/ 仍有入口） */
  @media (max-width: 1024px) {
    .sb { display: none; }
  }
</style>
