---
// 八眼 motif：Salticidae 的四对眼抽象为两个弧——本站的视觉签名。
// 用于 favicon、页脚与 404；刻意克制，不作大面积装饰。
interface Props {
  size?: number;
  color?: string;
}
const { size = 40, color = 'currentColor' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <circle cx="12" cy="36" r="3.2" fill={color} />
  <circle cx="24" cy="41" r="5.6" fill={color} />
  <circle cx="40" cy="41" r="5.6" fill={color} />
  <circle cx="52" cy="36" r="3.2" fill={color} />
  <circle cx="20" cy="19" r="2.6" fill={color} />
  <circle cx="28" cy="14.5" r="2.6" fill={color} />
  <circle cx="36" cy="14.5" r="2.6" fill={color} />
  <circle cx="44" cy="19" r="2.6" fill={color} />
</svg>
